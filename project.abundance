                {
                  "atomType": "Code",
                  "x": 0.5,
                  "y": 0.6,
                  "uniqueID": "id-165640",
                  "ioValues": [
                    {
                      "name": "shape",
                      "ioValue": "__GEOMETRY_INPUT__"
                    },
